<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    name="VixPHPCS">
    <description>VixPHPCS Coding Standard - Main ruleset</description>

    <rule ref="VixPHPCS.ControlStructures.DisallowThrowInTernary">
        <type>error</type>
    </rule>

    <rule ref="VixPHPCS.ControlStructures.UseInArray">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Formatting.MethodChainingIndentation">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Formatting.MethodChainingPerLine">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Formatting.ConsistentStatementIndentation">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Yii2.DisallowResponseFormatAssignment">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Yii2.PreferActiveRecordShortcuts">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Yii2.PreferExistsOverCount">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Yii2.PreferIsGuestOverUserIdCheck">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Yii2.PreferIdentityOverFindOne">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Objects.DisallowVariableStaticProperty">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Objects.RequireFinalTraitMethods">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Attributes.ForbiddenAttributes">
        <type>warning</type>
        <properties>
            <property name="forbiddenAttributes" type="array">
                <element value="ArrayShape" />
                <element value="JetBrains\PhpStorm\ArrayShape" />
                <element value="Pure" />
                <element value="JetBrains\PhpStorm\Pure" />
                <element value="Deprecated" />
                <element value="JetBrains\PhpStorm\Deprecated" />
            </property>
        </properties>
    </rule>

    <rule ref="VixPHPCS.Functions.PreferModernStringFunctions">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Functions.DisallowHttpFileGetContents">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Functions.PreferJsonValidate">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.Formatting.DisallowMultipleThrowsPerLine">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.PhpDoc.DisallowUnusedTemplate">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.PhpDoc.DeprecatedTag">
        <type>warning</type>
    </rule>

    <rule ref="VixPHPCS.PhpDoc.DisallowVoidMixedWithOtherTypes">
        <type>error</type>
    </rule>
</ruleset>
