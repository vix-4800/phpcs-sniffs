{
  "name": "vix/phpcs-sniffs",
  "description": "Custom PHP_CodeSniffer ruleset for strict development standards",
  "license": "MIT",
  "authors": [
    {
      "name": "Anton VIX",
      "email": "Gordan.ei@protonmail.ch"
    }
  ],
  "type": "phpcodesniffer-standard",
  "keywords": [
    "phpcs",
    "dev",
    "code-sniffer",
    "coding-standards",
    "static-analysis"
  ],
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "require": {
    "php": "^8.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "squizlabs/php_codesniffer": "^4.0.1"
  },
  "require-dev": {
    "captainhook/captainhook": "^5.29.2",
    "phpstan/phpstan": "^2.1.55",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan-strict-rules": "^2.0.11",
    "friendsofphp/php-cs-fixer": "^3.95.2",
    "phpunit/phpunit": "^13.1.10",
    "slevomat/coding-standard": "^8.29.0"
  },
  "autoload": {
    "psr-4": {
      "VixPHPCS\\": "src/VixPHPCS/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VixPHPCS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": "vendor/bin/captainhook install --only-enabled -f -s",
    "test": "php -d memory_limit=1G vendor/bin/phpunit --colors=always",
    "static-analysis": "vendor/bin/phpstan analyze --memory-limit=1G"
  }
}
